{
  // Repo-wide markdownlint config. Long lines are fine in prose/tables;
  // Keep-a-Changelog repeats section headings per release.
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    // The security docs quote the literal `[neutralized] ` prefix — its
    // trailing space is meaningful, not a typo.
    "MD038": false,
    // Historical audit docs use compact table pipes throughout.
    "MD060": false
  },
  // Without an explicit glob set, a bare `markdownlint-cli2` invocation
  // matches nothing and reports a vacuous "0 issues in 0 files".
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    "dist/**",
    "nugget/**",
    // Frozen historical/imported records (see their banners) — not reformatted.
    "AI_Context_Systems_Deep_Research_Report.md",
    "Context Nugget Audit.md",
    "docs/audit-2026-07-10.md",
    "docs/implementation-plan.md"
  ]
}
